### Como captar isso de **outros players** (básico)

Animações do personagem **replicam** se você as vê. No seu client:

1. Pega o `Character` do alvo  
2. Pega `Humanoid` → `Animator`  
3. Escuta `AnimationPlayed`  
4. Compara o Id numérico com a tabela  

#### Exemplo mínimo (copiar/colar)

```lua
local Players = game:GetService("Players")

-- IDs importantes
local ANIM = {
    Dash   = "7101914175",
    Rush   = "6670099827",
    Lunge  = "5277781176",
    Block  = "5967031692",
    M2     = "6515811762",
    Idle   = "6515884532",
    Walk   = "6515180141",
    Run    = "6515344460",
    Jump   = "5362637377",
    DoubleJump = "6827273734",
    Hit1   = "4860974676",
    Hit2   = "4860976017",
    DrawSword  = "6024616446",
    Sheathe    = "6024679361",
}

local function idOf(track)
    local anim = track and track.Animation
    if not anim then return nil end
    return tostring(anim.AnimationId):match("%d+")
end

local function isAnim(track, key)
    local id = idOf(track)
    return id and ANIM[key] == id
end

-- Conecta em UM player
local function watchPlayer(player, onAnim)
    local function hook(char)
        local hum = char:WaitForChild("Humanoid", 10)
        if not hum then return end
        local animator = hum:FindFirstChildOfClass("Animator")
            or hum:WaitForChild("Animator", 10)
        if not animator then return end

        animator.AnimationPlayed:Connect(function(track)
            local id = idOf(track)
            if not id then return end
            onAnim(player, id, track)
        end)
    end

    if player.Character then hook(player.Character) end
    player.CharacterAdded:Connect(hook)
end

-- Uso: detectar Dash / Lunge / Block no alvo
local target = Players:FindFirstChild("scullbit") -- ou o Player selecionado
if target then
    watchPlayer(target, function(player, id, track)
        if id == ANIM.Dash then
            print(player.Name, "→ DASH")
        elseif id == ANIM.Lunge then
            print(player.Name, "→ LUNGE")
        elseif id == ANIM.Block then
            print(player.Name, "→ DEFESA")
        elseif id == ANIM.M2 then
            print(player.Name, "→ M2")
        elseif id == ANIM.Rush then
            print(player.Name, "→ RUSH")
        end
    end)
end
```

#### Checagem “está tocando agora?” (sem evento)

```lua
local function isPlayingId(character, animId)
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then return false end
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        local id = idOf(track)
        if id == animId then return true end
    end
    return false
end

