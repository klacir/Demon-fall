-- Script de Auto-Teleporte para Demonfall
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local Player = Players.LocalPlayer

-- ID do Jogo Demonfall
local gameID = 5094651510

-- Função para realizar o teleporte
local function teleport()
    print("Teleportando para Demonfall...")
    TeleportService:Teleport(gameID, Player)
end

-- Executa o teleporte imediatamente
teleport()
